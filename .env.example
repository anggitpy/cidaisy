CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
database.default.hostname = 127.0.0.1
database.default.database = cidaisy
database.default.username = ''
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

# Use a separate disposable database for tests. Never point this at application data.
database.tests.hostname = 127.0.0.1
database.tests.database = cidaisy_test
database.tests.username = ''
database.tests.password = ''
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = test_

email.fromEmail = 'noreply@example.com'
email.fromName = 'Application administration'
